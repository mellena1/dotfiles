{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "@mellena1/opencode-auto-mode@0.3.6",
      "options": {
        "model": { "id": "deepseek-v4-flash", "providerID": "opencode-go" }
      }
    }
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "ls*": "allow",
      "find*": "allow",
      "mkdir*": "allow",
      "cat*": "allow",
      "pwd": "allow",
      "echo*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "which*": "allow",
      "cd *": "allow",
      "wc*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "diff*": "allow",
      "file*": "allow",
      "*": "ask"
    }
  }
}
